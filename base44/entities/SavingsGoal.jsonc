{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Goal name, e.g. Vacation, Emergency Fund"
    },
    "target_amount": {
      "type": "number",
      "description": "Amount the user wants to save",
      "minimum": 0
    },
    "current_amount": {
      "type": "number",
      "description": "Amount saved so far",
      "minimum": 0,
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Optional target date to reach the goal"
    },
    "color": {
      "type": "string",
      "description": "Accent color hex for the goal card"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for the goal"
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}